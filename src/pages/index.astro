---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import Projects from "@/components/Projects.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TitleSection from "@/components/TitleSection.astro"
import Skills from "@/components/Skills.astro"
---

<Layout
  title="Kevin Rodriguez - Desarrollador FullStack | Portfolio"
  description="Contrata a Kevin Rodriguez para crear tu aplicacion web. Full Stack Developer con +3 anos de experiencia. Especializado en Laravel, Node.js, Vue y Docker."
>
  <main class="px-4">
    <SectionContainer class="py-16 md:py-36">
      <Hero />
    </SectionContainer>

    <div class="space-y-32 pb-8">
      <SectionContainer id="experiencia">
        <TitleSection>
          <Briefcase class="size-7 text-blue-500" />
          Experiencia laboral
        </TitleSection>
        <Experience />
      </SectionContainer>

      <SectionContainer id="proyectos">
        <TitleSection>
          <CodeIcon class="size-7 text-violet-500" />
          Proyectos
        </TitleSection>
        <Projects />
      </SectionContainer>

      <SectionContainer id="skills">
        <TitleSection>
          <CodeIcon class="size-7 text-amber-500" />
          Skills & Tecnologias
        </TitleSection>
        <Skills />
      </SectionContainer>

      <SectionContainer id="sobre-mi">
        <TitleSection>
          <ProfileCheck class="size-7 text-blue-500" />
          Sobre mi
        </TitleSection>
        <AboutMe />
      </SectionContainer>
    </div>
  </main>
</Layout>
