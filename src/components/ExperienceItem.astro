---
interface Props {
  titleEs: string
  titleEn: string
  company: string
  descriptionEs: string
  descriptionEn: string
  tags?: string[]
  current?: boolean
  link?: string
  dateEs: string
  dateEn: string
}

const { titleEs, titleEn, company, descriptionEs, descriptionEn, tags, current, link, dateEs, dateEn } =
  Astro.props
---

<div class="relative pl-10">
  <!-- Dot on the timeline -->
  <div class="absolute left-0 top-7">
    <span class="relative flex h-3.5 w-3.5">
      {
        current && (
          <span class="animate-ping motion-reduce:animate-none absolute inline-flex h-full w-full rounded-full bg-apple-blue/40 dark:bg-apple-blue-dark/40" />
        )
      }
      <span
        class:list={[
          "relative inline-flex h-3.5 w-3.5 rounded-full ring-[3px] ring-apple-gray-50 dark:ring-apple-gray-950",
          current
            ? "bg-apple-blue dark:bg-apple-blue-dark"
            : "bg-apple-gray-300 dark:bg-apple-gray-700",
        ]}></span>
    </span>
  </div>

  <!-- Card -->
  <div
    class="rounded-3xl p-6 ring-1 backdrop-blur-xl transition-all duration-500
           bg-white/50 ring-apple-gray-200/70
           dark:bg-apple-gray-900/40 dark:ring-apple-gray-800
           hover:ring-apple-gray-300 dark:hover:ring-apple-gray-700
           hover:shadow-lg hover:shadow-black/5 dark:hover:shadow-black/30"
  >
    <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
      <h3 class="text-base font-semibold tracking-tight text-apple-gray-900 dark:text-white">
        <span data-i18n-es={titleEs} data-i18n-en={titleEn} class="i18n-text">{titleEs}</span>
      </h3>
      <span class="text-apple-gray-300 dark:text-apple-gray-700">·</span>
      <span class="text-sm font-medium text-apple-gray-500 dark:text-apple-gray-400">{company}</span>
    </div>

    <time
      class="mt-1 block text-[11px] font-semibold uppercase tracking-widest text-apple-gray-400 dark:text-apple-gray-500"
    >
      <span data-i18n-es={dateEs} data-i18n-en={dateEn} class="i18n-text">{dateEs}</span>
    </time>

    <p class="mt-3.5 max-w-2xl text-sm leading-relaxed text-pretty text-apple-gray-500 dark:text-apple-gray-400">
      <span data-i18n-es={descriptionEs} data-i18n-en={descriptionEn} class="i18n-text"
        >{descriptionEs}</span
      >
    </p>

    {
      tags && tags.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-md bg-apple-gray-100 px-2 py-0.5 text-[11px] font-medium text-apple-gray-500 dark:bg-apple-gray-800/60 dark:text-apple-gray-400">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-apple-blue hover:underline dark:text-apple-blue-dark"
        >
          <span data-i18n-es="Saber más" data-i18n-en="Learn more" class="i18n-text">
            Saber más
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3 w-3"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 6l6 6l-6 6" />
          </svg>
        </a>
      )
    }
  </div>
</div>
