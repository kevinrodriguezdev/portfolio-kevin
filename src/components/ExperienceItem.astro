---
interface Props {
  titleEs: string
  titleEn: string
  company: string
  descriptionEs: string
  descriptionEn: string
  tags?: string[]
  current?: boolean
  link?: string
  dateEs: string
  dateEn: string
}

const { titleEs, titleEn, company, descriptionEs, descriptionEn, tags, current, link, dateEs, dateEn } = Astro.props
---

<div class="relative pl-8">
  <!-- Dot on the timeline -->
  <div class="absolute left-0 top-[6px]">
    {current ? (
      <span class="relative flex h-3.5 w-3.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-apple-blue/40 dark:bg-apple-blue-dark/40"></span>
        <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-apple-blue dark:bg-apple-blue-dark ring-[3px] ring-white dark:ring-apple-gray-950"></span>
      </span>
    ) : (
      <span class="relative flex h-3.5 w-3.5">
        <span class="inline-flex rounded-full h-3.5 w-3.5 bg-apple-gray-300 dark:bg-apple-gray-700 ring-[3px] ring-white dark:ring-apple-gray-950"></span>
      </span>
    )}
  </div>

  <!-- Content -->
  <div>
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-3">
      <h3 class="text-base font-semibold text-apple-gray-800 dark:text-white">
        <span data-i18n-es={titleEs} data-i18n-en={titleEn} class="i18n-text">{titleEs}</span>
      </h3>
      <span class="text-apple-gray-400 dark:text-apple-gray-600 hidden sm:inline">·</span>
      <span class="text-sm font-medium text-apple-gray-500 dark:text-apple-gray-400">{company}</span>
    </div>

    <time class="block mt-0.5 text-xs font-medium uppercase tracking-wider text-apple-gray-400 dark:text-apple-gray-600">
      <span data-i18n-es={dateEs} data-i18n-en={dateEn} class="i18n-text">{dateEs}</span>
    </time>

    <p class="mt-3 text-sm text-apple-gray-500 dark:text-apple-gray-400 leading-relaxed max-w-2xl">
      <span data-i18n-es={descriptionEs} data-i18n-en={descriptionEn} class="i18n-text">{descriptionEs}</span>
    </p>

    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-3">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-md
                       bg-apple-gray-100 text-apple-gray-500
                       dark:bg-apple-gray-800/60 dark:text-apple-gray-500">
            {tag}
          </span>
        ))}
      </div>
    )}

    {link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 mt-3 text-xs font-medium text-apple-blue dark:text-apple-blue-dark hover:underline"
      >
        <span data-i18n-es="Saber más" data-i18n-en="Learn more" class="i18n-text">Saber más</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 6l6 6l-6 6" />
        </svg>
      </a>
    )}
  </div>
</div>
