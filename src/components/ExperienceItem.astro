---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  company: string
  description: string
  link?: string
  date: string
}

const { title, company, description, link, date } = Astro.props
---

<div class="reveal">
  <div
    class="relative ml-8 md:ml-14 pb-10 group"
  >
    <span
      class="absolute -left-[2.35rem] md:-left-[3.65rem] top-1 flex h-5 w-5 items-center justify-center"
    >
      <span
        class="h-3 w-3 rounded-full bg-gradient-to-br from-blue-500 to-violet-500 ring-4 ring-blue-100 dark:ring-blue-950"
      ></span>
    </span>

    <div
      class="glass rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:shadow-lg hover:scale-[1.01]"
    >
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-3">
        <h3 class="text-lg font-bold text-blue-600 dark:text-blue-400">
          {title}
        </h3>
        <time class="text-xs font-medium text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-800 rounded-full px-3 py-1">
          {date}
        </time>
      </div>
      <h4 class="text-base font-semibold text-gray-800 dark:text-gray-200 mb-3">
        {company}
      </h4>
      <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {description}
      </p>
      {
        link && (
          <div class="mt-3">
            <LinkInline href={link}>
              Saber mas
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4 inline ml-0.5"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M9 6l6 6l-6 6" />
              </svg>
            </LinkInline>
          </div>
        )
      }
    </div>
  </div>

</div>
