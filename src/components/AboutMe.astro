---
import LaravelIcon from "@/components/icons/Laravel.astro"
import PhpIcon from "@/components/icons/Php.astro"
import MySqlIcon from "@/components/icons/MySql.astro"
import VueIcon from "@/components/icons/Vue.astro"
import ReactIcon from "@/components/icons/ReactIcon.astro"
import TailwindIcon from "@/components/icons/Tailwind.astro"
import DockerIcon from "@/components/icons/Docker.astro"
import GitIcon from "@/components/icons/Git.astro"
import MailIcon from "@/components/icons/Mail.astro"

const t = {
  es: {
    p1: "Ingeniero de software con una obsesión por los sistemas bien diseñados. +5 años convirtiendo ideas complejas en código limpio y mantenible.",
    p2: "Laravel y PHP son mi terreno natural, pero no me quedo ahí — Vue, React y todo lo que haga falta para construir el mejor producto posible.",
    p3: "Actualmente lidero el backend en Degestec Games. Arquitectura, estándares, code reviews — lo que hace falta para que el equipo entregue su mejor trabajo.",
  },
  en: {
    p1: "Software engineer obsessed with well-designed systems. 5+ years turning complex ideas into clean, maintainable code.",
    p2: "Laravel and PHP are my home turf, but I don't stop there — Vue, React, and whatever it takes to build the best possible product.",
    p3: "Currently leading backend at Degestec Games. Architecture, standards, code reviews — whatever it takes for the team to ship their best work.",
  },
}

const stack = [
  { name: "Laravel", Icon: LaravelIcon },
  { name: "PHP", Icon: PhpIcon },
  { name: "MySQL", Icon: MySqlIcon },
  { name: "Vue", Icon: VueIcon },
  { name: "React", Icon: ReactIcon },
  { name: "Tailwind", Icon: TailwindIcon },
  { name: "Docker", Icon: DockerIcon },
  { name: "Git", Icon: GitIcon },
]

// Shared tile chrome — the bento look lives here so every cell stays consistent.
const tile =
  "rounded-3xl p-6 ring-1 backdrop-blur-xl transition-all duration-500 " +
  "bg-white/60 ring-apple-gray-200/70 " +
  "dark:bg-apple-gray-900/40 dark:ring-apple-gray-800 " +
  "hover:ring-apple-gray-300 dark:hover:ring-apple-gray-700"

const tileLabel =
  "text-[11px] font-semibold uppercase tracking-widest text-apple-gray-400 dark:text-apple-gray-500"
---

<div class="grid gap-4 md:grid-cols-4">
  <!-- Bio -->
  <article class={`${tile} md:col-span-2 md:row-span-2 flex flex-col justify-center`} data-reveal>
    <h3 class={tileLabel}>
      <span data-i18n-es="Perfil" data-i18n-en="Profile" class="i18n-text">Perfil</span>
    </h3>
    <div
      class="mt-4 space-y-4 text-pretty leading-relaxed text-apple-gray-500 dark:text-apple-gray-400"
    >
      <p><span data-i18n-es={t.es.p1} data-i18n-en={t.en.p1} class="i18n-text">{t.es.p1}</span></p>
      <p><span data-i18n-es={t.es.p2} data-i18n-en={t.en.p2} class="i18n-text">{t.es.p2}</span></p>
      <p><span data-i18n-es={t.es.p3} data-i18n-en={t.en.p3} class="i18n-text">{t.es.p3}</span></p>
    </div>
  </article>

  <!-- Specialty -->
  <article class={`${tile} flex flex-col justify-between gap-6`} data-reveal data-reveal-delay="1">
    <LaravelIcon class="size-9" />
    <div>
      <p class="text-lg font-semibold tracking-tight text-apple-gray-900 dark:text-white">
        Laravel &amp; PHP
      </p>
      <p class="mt-1 text-sm text-apple-gray-500 dark:text-apple-gray-400">
        <span data-i18n-es="Mi terreno natural" data-i18n-en="My home turf" class="i18n-text"
          >Mi terreno natural</span
        >
      </p>
    </div>
  </article>

  <!-- Current role -->
  <article class={`${tile} flex flex-col justify-between gap-6`} data-reveal data-reveal-delay="2">
    <span class="relative flex h-2.5 w-2.5">
      <span
        class="animate-ping motion-reduce:animate-none absolute inline-flex h-full w-full rounded-full bg-apple-blue/50"
      ></span>
      <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-apple-blue dark:bg-apple-blue-dark"
      ></span>
    </span>
    <div>
      <h3 class={tileLabel}>
        <span data-i18n-es="Ahora mismo" data-i18n-en="Right now" class="i18n-text">Ahora mismo</span>
      </h3>
      <p class="mt-2 text-lg font-semibold tracking-tight text-apple-gray-900 dark:text-white">
        Backend Lead
      </p>
      <p class="mt-0.5 text-sm text-apple-gray-500 dark:text-apple-gray-400">Degestec Games</p>
    </div>
  </article>

  <!-- Stack -->
  <article class={`${tile} md:col-span-2`} data-reveal data-reveal-delay="3">
    <h3 class={tileLabel}>Stack</h3>
    <div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4">
      {
        stack.map((tech) => (
          <div
            class="flex flex-col items-center gap-2 rounded-2xl px-2 py-3.5
                   bg-apple-gray-50 dark:bg-apple-gray-800/50
                   transition-transform duration-300 hover:-translate-y-0.5"
            title={tech.name}
          >
            <tech.Icon class="size-6" />
            <span class="text-xs font-medium text-apple-gray-600 dark:text-apple-gray-400">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>
  </article>

  <!-- Contact CTA -->
  <article
    class="md:col-span-4 rounded-3xl p-8 ring-1 transition-all duration-500
           bg-gradient-to-br from-apple-gray-900 to-apple-gray-700 ring-black/10
           dark:from-apple-gray-800 dark:to-apple-gray-900 dark:ring-white/10
           flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"
    data-reveal
    data-reveal-delay="4"
  >
    <div>
      <p class="text-xl font-semibold tracking-tight text-white">
        <span
          data-i18n-es="¿Construimos algo juntos?"
          data-i18n-en="Shall we build something together?"
          class="i18n-text">¿Construimos algo juntos?</span
        >
      </p>
      <p class="mt-1.5 text-sm text-apple-gray-300">
        <span
          data-i18n-es="Abierto a proyectos y conversaciones interesantes."
          data-i18n-en="Open to projects and interesting conversations."
          class="i18n-text">Abierto a proyectos y conversaciones interesantes.</span
        >
      </p>
    </div>
    <a
      href="mailto:kevinrodriguezdev@gmail.com"
      class="inline-flex shrink-0 items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-medium
             text-apple-gray-900 transition-all duration-300 hover:-translate-y-0.5 hover:bg-apple-gray-100
             focus:outline-none focus-visible:ring-2 focus-visible:ring-white/70 focus-visible:ring-offset-2
             focus-visible:ring-offset-apple-gray-900"
    >
      <MailIcon class="size-4" />
      <span data-i18n-es="Escríbeme" data-i18n-en="Get in touch" class="i18n-text">Escríbeme</span>
    </a>
  </article>
</div>
