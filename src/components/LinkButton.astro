---
const { href } = Astro.props
---

<a
  target="_blank"
  href={href}
  role="link"
  class="glass inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-md hover:text-blue-600 dark:hover:text-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/50 active:scale-95"
>
  <slot />
</a>
