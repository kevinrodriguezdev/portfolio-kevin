---
import ThemeToggle from "./ThemeToggle.astro"
import LanguageToggle from "./LanguageToggle.astro"

const navItems = [
  {
    titleEs: "Experiencia",
    titleEn: "Experience",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    titleEs: "Proyectos",
    titleEn: "Projects",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    titleEs: "Sobre mí",
    titleEn: "About",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    titleEs: "Contacto",
    titleEn: "Contact",
    label: "contacto",
    url: "mailto:kevinrodriguezdev@gmail.com",
  },
]
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="flex px-4 py-2 text-sm font-medium rounded-full justify-center items-center gap-1
           bg-white/70 dark:bg-apple-gray-900/70 backdrop-blur-xl
           border border-apple-gray-200/50 dark:border-apple-gray-700/50
           shadow-sm"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative block px-3 py-1.5 rounded-full transition-colors
                 text-apple-gray-500 hover:text-apple-gray-800
                 dark:text-apple-gray-400 dark:hover:text-white"
          aria-label={link.label}
          href={link.url}
          data-title-es={link.titleEs}
          data-title-en={link.titleEn}
        >
          {link.titleEs}
        </a>
      ))
    }
    <div class="w-px h-4 bg-apple-gray-200 dark:bg-apple-gray-700 mx-1"></div>
    <ThemeToggle />
    <LanguageToggle />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a.nav-link")

    const callback = (entries: any[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-apple-gray-800", "dark:text-white")
            } else {
              item.classList.remove("text-apple-gray-800", "dark:text-white")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    })

    sections.forEach((section) => {
      observer.observe(section)
    })

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => {
          observer.observe(section)
        })
      }
    }
  })

  // Language swap for nav items
  function updateNavLang(lang: string) {
    document.querySelectorAll('a.nav-link').forEach((a) => {
      const el = a as HTMLElement;
      const key = lang === 'en' ? 'data-title-en' : 'data-title-es';
      el.textContent = el.getAttribute(key) || el.textContent;
    });
  }

  document.addEventListener('langchange', ((e: CustomEvent) => {
    updateNavLang(e.detail.lang);
  }) as EventListener);

  // Set initial language
  updateNavLang(localStorage.getItem('lang') || 'es');
  document.addEventListener('astro:after-swap', () => {
    updateNavLang(localStorage.getItem('lang') || 'es');
  });
</script>
