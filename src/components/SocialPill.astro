---
interface Props {
  href: string
}

const { href } = Astro.props
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="glass inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 transition-all duration-300 hover:scale-105 hover:shadow-md hover:text-blue-600 dark:hover:text-blue-400 hover:ring-1 hover:ring-blue-400/30"
>
  <slot />
</a>
