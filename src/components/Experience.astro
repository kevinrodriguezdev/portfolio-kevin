---
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
  {
    date: { es: "2026 — Actualidad", en: "2026 — Present" },
    title: { es: "Lead Backend Developer", en: "Lead Backend Developer" },
    company: "Degestec Games",
    description: {
      es: "Organización y liderazgo técnico del equipo de backend: revisión de código, definición de estándares y buenas prácticas. Combino la gestión del equipo con el desarrollo.",
      en: "Organization and technical leadership of the backend team: code reviews, coding standards and best practices. I combine managing the team with hands-on development.",
    },
    tags: ["Laravel", "PHP", "Vue", "Node.js", "TypeScript", "Docker"],
    current: true,
  },
  {
    date: { es: "2025", en: "2025" },
    title: { es: "Desarrollador FullStack", en: "FullStack Developer" },
    company: "Degestec Games",
    description: {
      es: "Desarrollo de aplicaciones internas desde cero con Laravel y Vue, y migración de sistemas legacy a un stack actual. APIs REST en Laravel y Node.js, y entornos de desarrollo reproducibles con Docker.",
      en: "Built internal applications from scratch with Laravel and Vue, and migrated legacy systems to a modern stack. REST APIs in Laravel and Node.js, and reproducible development environments with Docker.",
    },
    tags: ["Laravel", "Vue", "Node.js", "Docker"],
  },
  {
    date: { es: "2021 — 2024", en: "2021 — 2024" },
    title: { es: "Desarrollador FullStack", en: "FullStack Developer" },
    company: "Sodecia Automotive",
    description: {
      es: "Único desarrollador del equipo, a cargo de las aplicaciones internas en PHP. Aplicaciones de gestión y trazabilidad para operarios de línea de producción, paneles de reporting para control de calidad y digitalización de procesos administrativos.",
      en: "Sole developer on the team, responsible for the internal PHP applications. Management and traceability apps for production line operators, quality control reporting dashboards and digitalization of administrative processes.",
    },
    tags: ["PHP", "JavaScript", "SQL Server"],
    link: "https://www.linkedin.com/in/kevinrodriguezdev/",
  },
  {
    date: { es: "2021", en: "2021" },
    title: { es: "Desarrollador Frontend", en: "Frontend Developer" },
    company: "La Cruz Azul",
    description: {
      es: "Prácticas profesionales en desarrollo frontend. Trabajo colaborativo en equipo, gestión de tareas y mantenimiento de la interfaz de usuario del proyecto.",
      en: "Professional internship in frontend development. Collaborative teamwork, task management and maintenance of the project's user interface.",
    },
    tags: ["HTML", "CSS", "JavaScript"],
  },
]
---

<div class="mt-10 relative">
  <!-- Vertical line -->
  <div class="absolute left-[7px] top-8 bottom-8 w-px bg-gradient-to-b from-apple-gray-200 via-apple-gray-200 to-transparent dark:from-apple-gray-800 dark:via-apple-gray-800"></div>

  <div class="space-y-5">
    {
      EXPERIENCE.map((experience, index) => (
        <div data-reveal data-reveal-delay={index + 1}>
          <ExperienceItem
            dateEs={experience.date.es}
            dateEn={experience.date.en}
            titleEs={experience.title.es}
            titleEn={experience.title.en}
            company={experience.company}
            descriptionEs={experience.description.es}
            descriptionEn={experience.description.en}
            tags={experience.tags}
            current={experience.current}
            link={experience.link}
          />
        </div>
      ))
    }
  </div>
</div>
