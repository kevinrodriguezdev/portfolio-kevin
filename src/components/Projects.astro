---
import GitHub from "./icons/GitHub.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Astroicon from "./icons/Astroicon.astro"

const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-apple-gray-100 text-apple-gray-600 dark:bg-apple-gray-800 dark:text-apple-gray-300",
    icon: Astroicon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-apple-gray-100 text-apple-gray-600 dark:bg-apple-gray-800 dark:text-apple-gray-300",
    icon: Tailwind,
  },
}

const PROJECTS = [
  {
    title: { es: "Dossier — Landing Page", en: "Dossier — Landing Page" },
    description: {
      es: "Landing page para la venta de un dosier para la prueba de acceso de grados medios en España. Diseñada y desarrollada desde cero con Astro y Tailwind CSS.",
      en: "Landing page for selling a dossier for the middle school access exam in Spain. Designed and developed from scratch with Astro and Tailwind CSS.",
    },
    link: "https://pruebadeacceso.vercel.app/",
    github: "https://github.com/kevinrodriguezdev/grado-medio",
    image: "/projects/pruebadeacceso.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
  },
]
---

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }, index) => (
      <article
        data-reveal="scale"
        data-reveal-delay={index + 1}
        class="group overflow-hidden rounded-2xl transition-all duration-300
               bg-apple-gray-50/50 dark:bg-apple-gray-800/30
               border border-apple-gray-200/40 dark:border-apple-gray-700/40
               hover:shadow-lg hover:border-apple-gray-200
               dark:hover:border-apple-gray-600/60"
      >
        <div class="overflow-hidden">
          <img
            alt={title.es}
            class="object-cover object-top w-full aspect-video transition-transform duration-500 group-hover:scale-[1.03]"
            loading="lazy"
            src={image}
          />
        </div>

        <div class="p-6">
          <h3 class="text-xl font-semibold text-apple-gray-800 dark:text-white">
            <span data-i18n-es={title.es} data-i18n-en={title.en} class="i18n-text">{title.es}</span>
          </h3>

          <ul class="flex flex-wrap gap-2 mt-3">
            {tags.map((tag) => (
              <li>
                <span class={`flex items-center gap-1.5 rounded-full text-xs font-medium ${tag.class} py-1 px-2.5`}>
                  <tag.icon class="size-3.5" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="mt-3 text-sm text-apple-gray-500 dark:text-apple-gray-400 leading-relaxed">
            <span data-i18n-es={description.es} data-i18n-en={description.en} class="i18n-text">{description.es}</span>
          </p>

          <footer class="flex items-center gap-3 mt-4 pt-4 border-t border-apple-gray-200/40 dark:border-apple-gray-700/40">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-4" />
                <span data-i18n-es="Código" data-i18n-en="Code" class="i18n-text">Código</span>
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <Link class="size-4" />
                <span data-i18n-es="Vista previa" data-i18n-en="Preview" class="i18n-text">Vista previa</span>
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>



