---
const currentYear = new Date().getFullYear()
---

<footer
  class="mt-24 mb-8 w-full mx-auto container lg:max-w-4xl md:max-w-2xl flex justify-center"
>
  <div
    class="glass rounded-2xl w-full max-w-screen-xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 px-6 py-4"
  >
    <span class="text-sm text-gray-600 dark:text-gray-400">
      &copy; {currentYear} Kevin Rodriguez
    </span>
    <ul class="flex items-center gap-6 text-sm font-medium text-gray-600 dark:text-gray-400">
      <li>
        <a href="/#sobre-mi" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Sobre mi</a>
      </li>
      <li>
        <a href="mailto:kevinrodriguezdev@gmail.com" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">Contacto</a>
      </li>
    </ul>
  </div>
</footer>
